<?xml version="1.0" encoding="UTF-8"?>
<!-- Aggregator only: lets you run `mvn test` / `mvn package` for every service from the repo root.
     Each service has its own spring-boot-starter-parent and can also be built on its own. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.bookhive</groupId>
    <artifactId>bookhive-microservices</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>bookhive-microservices</name>
    <modules>
        <module>config-server</module>
        <module>eureka-server</module>
        <module>api-gateway</module>
        <module>user-service</module>
        <module>club-service</module>
        <module>notification-service</module>
    </modules>
</project>
