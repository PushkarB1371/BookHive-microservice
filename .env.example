# Copy to .env and change the values. Never commit .env.

# Shared secret used by all services to sign/verify JWTs (at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Postgres superuser password (one container, three databases: userdb, clubdb, notificationdb)
POSTGRES_PASSWORD=change-me

# Admin account created on first start of user-service (used to add books)
ADMIN_EMAIL=admin@bookhive.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=BookHive Admin

# Optional: Google Books API key for catalog search (works with low quota without one)
GOOGLE_BOOKS_API_KEY=
